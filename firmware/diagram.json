{
  "version": 1,
  "author": "Antigravity",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-potentiometer", "id": "pot_temp", "top": -120, "left": -160, "attrs": { "label": "Temp (0-100 C)" } },
    { "type": "wokwi-potentiometer", "id": "pot_hum", "top": -20, "left": -160, "attrs": { "label": "Hum (0-100 %)" } },
    { "type": "wokwi-potentiometer", "id": "pot_lux", "top": 80, "left": -160, "attrs": { "label": "Lux (0-1000 lx)" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:3V3", "pot_temp:VCC", "red", [ "v0" ] ],
    [ "esp:3V3", "pot_hum:VCC", "red", [ "v0" ] ],
    [ "esp:3V3", "pot_lux:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "pot_temp:GND", "black", [ "v0" ] ],
    [ "esp:GND.1", "pot_hum:GND", "black", [ "v0" ] ],
    [ "esp:GND.1", "pot_lux:GND", "black", [ "v0" ] ],
    [ "pot_temp:SIG", "esp:34", "green", [ "v0" ] ],
    [ "pot_hum:SIG", "esp:35", "blue", [ "v0" ] ],
    [ "pot_lux:SIG", "esp:32", "orange", [ "v0" ] ]
  ],
  "dependencies": {}
}
